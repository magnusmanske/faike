{
  "//": "Copy to config.json and edit. JSON has no comments; keys starting with // are ignored.",
  "//user_agent": "Required by Wikimedia policy: include a contactable URL or e-mail.",
  "user_agent": "faike/0.1 (https://faike.toolforge.org; you@example.org)",

  "//wikis": "The wiki list lives in the store (ToolsDB `wikis` table or wikis.json); add, disable or remove wikis there.",

  "poll_interval_sec": 15,
  "backfill_events": 50,
  "max_batch": 500,
  "request_timeout_sec": 60,
  "max_wikitext_bytes": 65536,

  "max_download_bytes": 67108864,
  "download_concurrency": 2,
  "download_mime_prefixes": ["image/"],

  "min_score": 30,
  "abuse_filter_min_score": 80,
  "max_records": 2000,

  "//store": "kind 'file' is a local JSONL file with one writer; 'toolsdb' is the shared Toolforge database.",
  "store": {
    "kind": "toolsdb",
    "//file": "Used by the 'file' backend. Must be on persistent storage on Toolforge.",
    "file": "detections.jsonl",
    "wikis_file": "wikis.json",
    "//database": "Empty derives <tool user>__faike_p. ToolsDB names start with the tool user.",
    "database": "s58339__faike_p",
    "//replica_my_cnf": "On Toolforge leave null: toolforge finds $TOOL_DATA_DIR/replica.my.cnf. For local tests point at a copy with local='true' and run toolforge-tunnel.",
    "replica_my_cnf": null,
    "pool_max": 3,
    "connect_timeout_sec": 10,
    "max_statement_time_sec": 30
  },

  "//web_address": "Use 0.0.0.0 on Toolforge, or set FAIKE_ADDRESS.",
  "web_address": "127.0.0.1",
  "web_port": 8000,
  "refresh_sec": 60,

  "detect": {
    "c2pa": true,
    "exif": true,
    "xmp": true,
    "png_text": true,
    "container": true,
    "fingerprint": true,
    "metadata": true,
    "classifier": {
      "//model_path": "Run scripts/fetch-classifier.sh models first. Optional: skipped when the file is absent.",
      "enabled": true,
      "model_path": "models/ai-image-detector.onnx",
      "input_size": 224,
      "ai_label": 0,
      "threshold": 0.95
    },
    "watermark": {
      "//models_dir": "Run scripts/fetch-models.sh /data/project/faike/models first.",
      "enabled": true,
      "dwt_dct": true,
      "trustmark": true,
      "models_dir": "models",
      "trustmark_variant": "Q",
      "trustmark_version": "Bch5",
      "dwt_match_threshold": 0.85,
      "dwt_margin_threshold": 0.35,
      "dwt_generic_margin_threshold": 0.90,
      "dwt_lock_threshold": 0.60
    }
  }
}
